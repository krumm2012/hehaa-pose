# ==============================================================================
# 网球动作分析系统 - 本地环境变量配置示例模板 (.env.example)
# 使用方法: 复制本文件为 .env.local 并填入您的实际 API Key 与相关配置
# 命令示例: cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DeepSeek 大模型配置 (用于学员跨场次击球共性与矛盾诊断)
# ------------------------------------------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选默认模型：deepseek-flash (V4 Flash 架构), deepseek-chat (V3), deepseek-reasoner (R1)
# DEEPSEEK_MODEL=deepseek-flash

# ------------------------------------------------------------------------------
# 2. OpenAI / Claude 兼容大模型配置 (用于 o3-mini / GPT-4.5 / GPT-4.1 / GPT-4o / Claude 3.7)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
# 可选：如果使用代理中转，取消注释并填入：
# OPENAI_BASE_URL=https://api.openai.com/v1
# 推荐模型：o3-mini (轻快级思维链因果推理), gpt-4.5-preview, gpt-4.1, gpt-4o, claude-3-7-sonnet
# OPENAI_MODEL=o3-mini

# ------------------------------------------------------------------------------
# 3. Google Gemini 大模型配置 (用于 Gemini 2.5 Flash / Gemini 2.5 Pro)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# 推荐模型：gemini-2.5-flash (全新 Flash Thinking 架构), gemini-2.5-pro, gemini-2.0-flash
# GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. 球场 RTSP 摄像头接入凭据 (可选)
# ------------------------------------------------------------------------------
# TENNIS_RTSP_USERNAME=admin
# TENNIS_RTSP_PASSWORD=your_camera_password
