# Copy to .camera-credentials.local.env at the repository root.
# Fill in once, restart the control panel, leave browser credential fields blank.
# Existing environment variables take precedence over this file.
TENNIS_RTSP_USERNAME='admin'
TENNIS_RTSP_PASSWORD=''

# Optional per-channel pairs, keyed by ROI stream_id (hyphen becomes underscore).
# Empty username falls back to the common credentials above.
TENNIS_CAMERA_COURT01_MAIN_USERNAME=''
TENNIS_CAMERA_COURT01_MAIN_PASSWORD=''
TENNIS_CAMERA_COURT02_MAIN_USERNAME=''
TENNIS_CAMERA_COURT02_MAIN_PASSWORD=''
TENNIS_CAMERA_COURT03_MAIN_USERNAME=''
TENNIS_CAMERA_COURT03_MAIN_PASSWORD=''
